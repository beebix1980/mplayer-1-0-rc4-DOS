diff --git a/TOOLS/sb16vol.c b/TOOLS/sb16vol.c
new file mode 100644
index 0000000..a651b26
--- /dev/null
+++ b/TOOLS/sb16vol.c
@@ -0,0 +1,72 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <conio.h>
+#include <pc.h>
+
+int main(int argc, char *argv[]) {
+    uint16_t sb_port = 0x220;
+    int vol_percent = 100;
+
+    printf("\nSound Blaster 16 Hardware Mixer Utility v1.0\n");
+    printf("===========================================\n");
+
+    // 1. Parse BLASTER environment variable
+    char *blaster = getenv("BLASTER");
+    if (blaster) {
+        char *p = blaster;
+        while (*p) {
+            if (*p == 'A' || *p == 'a') {
+                sb_port = strtol(p + 1, NULL, 16);
+                break;
+            }
+            p++;
+        }
+    }
+
+    // 2. Parse volume command line argument
+    if (argc > 1) {
+        int val = atoi(argv[1]);
+        if (val >= 0 && val <= 100) {
+            vol_percent = val;
+        } else {
+            printf("Usage: sb16vol [volume_percent]\n");
+            printf("Volume percentage must be between 0 and 100. Default is 100.\n");
+            return 1;
+        }
+    }
+
+    // 3. Map 0-100% to 5-bit register range (0 to 31)
+    int sb_vol = (vol_percent * 31) / 100;
+    // Shift left by 3 bits to align with high 5 bits of SB16 mixer register layout (bits 7-3)
+    uint8_t reg_val = (sb_vol << 3) & 0xF8;
+
+    printf("Detected Sound Blaster Port: 0x%03X\n", sb_port);
+    printf("Setting Mixer Master and DAC Volumes to: %d%% (Mixer raw value: 0x%02X)\n", vol_percent, reg_val);
+
+    // 4. Write to SB16 Mixer Ports
+    // Mixer registers:
+    // 0x30: Master Volume Left
+    // 0x31: Master Volume Right
+    // 0x32: Voice/DAC Volume Left
+    // 0x33: Voice/DAC Volume Right
+    
+    // Master Volume Left
+    outportb(sb_port + 4, 0x30);
+    outportb(sb_port + 5, reg_val);
+    
+    // Master Volume Right
+    outportb(sb_port + 4, 0x31);
+    outportb(sb_port + 5, reg_val);
+    
+    // Voice/DAC Volume Left
+    outportb(sb_port + 4, 0x32);
+    outportb(sb_port + 5, reg_val);
+    
+    // Voice/DAC Volume Right
+    outportb(sb_port + 4, 0x33);
+    outportb(sb_port + 5, reg_val);
+
+    printf("Hardware Mixer configuration successfully updated!\n\n");
+    return 0;
+}
diff --git a/build_djgpp.sh b/build_djgpp.sh
new file mode 100755
index 0000000..c26fe12
--- /dev/null
+++ b/build_djgpp.sh
@@ -0,0 +1,41 @@
+#!/bin/sh
+# Cross-build MPlayer 1.0rc4 for DOS with DJGPP (i586-pc-msdosdjgpp, GCC 15).
+#
+# Usage: ./build_djgpp.sh [extra configure options]
+#   DJGPP_PREFIX can point to the DJGPP cross toolchain installation.
+
+DJGPP_PREFIX=${DJGPP_PREFIX:-/home/tho/dev/djgpp-install}
+export PATH="$DJGPP_PREFIX/bin:$PATH"
+
+# -std=gnu99: GCC 15 defaults to C23, where "int (*f)()" means "no arguments"
+# and K&R style code no longer compiles.
+# -fomit-frame-pointer: required on x86_32 when HAVE_EBP_AVAILABLE / HAVE_7REGS
+# is set for FFmpeg inline assembly.
+CFLAGS="-O3 -ffast-math -march=i686 -mtune=generic -pipe -fomit-frame-pointer -std=gnu99 \
+ -Wno-incompatible-pointer-types -Wno-int-conversion \
+ -Wno-implicit-function-declaration -Wno-implicit-int" \
+./configure \
+  --enable-cross-compile \
+  --target=i586-pc-msdosdjgpp \
+  --cc=i586-pc-msdosdjgpp-gcc \
+  --as=i586-pc-msdosdjgpp-as \
+  --ar=i586-pc-msdosdjgpp-ar \
+  --ranlib=i586-pc-msdosdjgpp-ranlib \
+  --host-cc=gcc \
+  --enable-vesa \
+  --enable-mmx \
+  --enable-mmxext \
+  --enable-sse \
+  --disable-sse2 \
+  --enable-ssse3 \
+  --disable-win32dll \
+  --disable-qtx \
+  --disable-real \
+  --disable-xanim \
+  --disable-vidix \
+  --disable-pthreads \
+  "$@" || exit 1
+
+make -j"$(nproc)" || exit 1
+
+ls -l mplayer.exe mencoder.exe
